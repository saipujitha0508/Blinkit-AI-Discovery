# Copy this file and rename the copy to ".env"
# Then fill in your real keys. Never share your .env file.

# ============================================
# AI MODELS
# ============================================

# Google Gemini 2.5 Flash
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Llama)
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# DATABASE
# ============================================

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# ============================================
# DATA COLLECTION APIS
# ============================================

# Apify (for Reddit, YouTube, News scraping)
# Get token: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=your_apify_token_here

# Reddit API (for direct Reddit access)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=your_reddit_user_agent

# ============================================
# APPLICATION SETTINGS
# ============================================

# App Configuration
APP_NAME=Blinkit AI Discovery Engine
APP_VERSION=1.0.0
DEBUG=False

# Data Processing
MAX_REVIEWS_PER_SOURCE=1000
BATCH_SIZE=100
RELEVANCE_THRESHOLD=0.7

# AI Pipeline
AI_MODEL_PRIMARY=gemini
AI_MODEL_FALLBACK=groq
MAX_TOKENS=4000
TEMPERATURE=0.7

# Dashboard
REFRESH_INTERVAL=300
CACHE_DURATION=3600
